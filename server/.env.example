# Bingo Arena Backend Environment Variables
PORT=5000
NODE_ENV=development

# Frontend Origin URL for CORS and Socket.IO (comma-separated if multiple, e.g. https://bingo-arena.vercel.app,https://bingo-arena-*.vercel.app)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String (Atlas Dashboard -> Database -> Connect -> Connect your application)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/bingo_arena?retryWrites=true&w=majority
